# Copie para .env e ajuste se necessário

# Caminho do modelo whisper.cpp (baixado pelo scripts/setup.sh)
WHISPER_MODEL_PATH=data/models/ggml-medium.bin

# Modelo Ollama usado para o resumo/análise
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Pasta com os projetos reais da Voltbras (irmã deste projeto), usada para
# casar o assunto da reunião com projeto/módulo
VOLTBRAS_DIR=/Users/sls/voltbras

# Nome de quem fala no microfone (você)
MIC_SPEAKER_NAME=Bruno Sales

# Nome do dispositivo de áudio de sistema (criado pelo BlackHole)
SYSTEM_AUDIO_DEVICE_NAME=BlackHole 2ch

# Modo automático: fica escutando o áudio de sistema e inicia/para a
# gravação sozinho (1 = ligado, 0 = só controle manual pelo dashboard)
AUTO_LISTEN=1
AUTO_LISTEN_START_SECONDS=5
AUTO_LISTEN_STOP_SECONDS=30
AUTO_LISTEN_THRESHOLD=0.01

PORT=8756
